instance simple_train_model{
    domain = train_system;
    non-fluents = nf_simple_train_model;

    init-state{
        train_timer(t1) = 10;
        current_state(t1) = 0;
        current_station(t1) = s1;
        train_timer(t2) = 40;
        current_state(t2) = 0;
        current_station(t2) = s1;
        train_timer(t3) = 70;
        current_state(t3) = 0;
        current_station(t3) = s1;
        train_timer(t4) = 100;
        current_state(t4) = 0;
        current_station(t4) = s1;
        train_timer(t5) = 130;
        current_state(t5) = 0;
        current_station(t5) = s1;
        train_timer(t6) = 160;
        current_state(t6) = 0;
        current_station(t6) = s1;
        train_timer(t7) = 190;
        current_state(t7) = 0;
        current_station(t7) = s1;
        train_timer(t8) = 220;
        current_state(t8) = 0;
        current_station(t8) = s1;
        train_timer(t9) = 250;
        current_state(t9) = 0;
        current_station(t9) = s1;
        train_timer(t10) = 280;
        current_state(t10) = 0;
        current_station(t10) = s1;
    };

    max-nondef-actions = pos-inf;
    horizon = 110;
    discount = 1.0;

}

