        PASSENGER_ARRIVAL_VAR(s2) = 1.6;
        PASSENGER_ARRIVAL_RATE(s3) = 7.0;
        PASSENGER_ARRIVAL_VAR(s3) = 1.4;
        PASSENGER_ARRIVAL_RATE(s4) = 7.0;
