non-fluents nf_simple_train_model{
    domain = train_system;

    objects{
        train : {t1, t2, t3, t4, t5, t6, t7, t8, t9, t10};
        station : {s1, s2, s3, s4, s5};
    };

    non-fluents{
        NEXT_TRAIN(t1, t2) = true;
        NEXT_TRAIN(t2, t3) = true;
        NEXT_TRAIN(t3, t4) = true;
        NEXT_TRAIN(t4, t5) = true;
        NEXT_TRAIN(t5, t6) = true;
        NEXT_TRAIN(t6, t7) = true;
        NEXT_TRAIN(t7, t8) = true;
        NEXT_TRAIN(t8, t9) = true;
        NEXT_TRAIN(t9, t10) = true;
        NEXT_TRAIN(t10, t1) = true;

        DEPOT_STATION(s5) = true;

        NEXT_STATION(s1, s2) = true;
        FIND_NEXT_STATION(s1) = s2;
        NEXT_STATION(s2, s3) = true;
        FIND_NEXT_STATION(s2) = s3;
        NEXT_STATION(s3, s4) = true;
        FIND_NEXT_STATION(s3) = s4;
        NEXT_STATION(s4, s5) = true;
        FIND_NEXT_STATION(s4) = s5;
        FIND_NEXT_STATION(s5) = s5;
        FIRST_TRAIN = t1;

        DRIVE_TIME(s1, s2) = 41;
        DRIVE_TIME(s2, s3) = 32;
        DRIVE_TIME(s3, s4) = 51;
        DRIVE_TIME(s4, s5) = 57;

        DISEMBARKING_PRECENTAGE(s1) = 0.23;
        DISEMBARKING_PRECENTAGE(s2) = 0.13;
        DISEMBARKING_PRECENTAGE(s3) = 0.33;
        DISEMBARKING_PRECENTAGE(s4) = 0.07;
        DISEMBARKING_PRECENTAGE(s5) = 0.23;

        PASSENGER_ARRIVAL_RATE(s1) = 5.0;
